---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pic from '../components/Pic.astro';
import Logo from '../components/Logo.astro';
import CtaBand from '../components/CtaBand.astro';
import { u } from '../lib/url.js';
---
<Base title="Về Nuseva" description="Câu chuyện Nuseva Studio: studio Pilates kèm riêng mở từ 2025, ở Quận 1 và Phú Nhuận. Vì sao tụi mình mở Nuseva và cách tụi mình dạy.">
  <PageHero kicker="Về Nuseva" title="Nơi huấn luyện viên có thời gian cho từng người" image="hlv-chinh-form" alt="Huấn luyện viên Nuseva chỉnh tư thế cho học viên" pos="50% 30%" />

  <section class="sec">
    <div class="wrap two">
      <h2 class="k">Vì sao có Nuseva</h2>
      <div>
        <p class="lead" data-fill>Nuseva bắt đầu vì tụi mình muốn dạy Pilates lâu dài, theo cách mình thấy đúng, và giúp được nhiều người hơn.</p>
        <div class="prose more" data-reveal>
          <p>Một chỗ mà huấn luyện viên có đủ thời gian cho từng người, không phải chạy theo số lượng học viên.</p>
          <p>Nuseva mở cửa ở Quận 1 từ đầu năm 2025, chỉ dạy kèm riêng. Studio Quận 1 hiện nằm ở Cống Quỳnh. Tháng 8 năm 2026, Nu mở thêm studio thứ hai ở Phan Đăng Lưu, Phú Nhuận. Nơi này rộng hơn, có thêm Barre, Yoga, Dance và lớp nhóm nhỏ.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec why">
    <div class="wrap">
      <h2 class="d2" data-split>Người tập ở lại vì điều gì</h2>
      <p class="sub" data-reveal>Phần lớn học viên của Nuseva là người đi làm văn phòng, muốn chỉnh dáng, bớt đau mỏi và vận động vừa sức trong thời gian dài. Đây là những lý do họ hay nhắc tới:</p>
      <ol class="why-list" data-stagger>
        <li><h3 class="d3">Riêng tư</h3><p>Lớp 1:1 và 1:2 là chính. Không phải chen trong một lớp đông người.</p></li>
        <li><h3 class="d3">Huấn luyện viên theo sát</h3><p>Mỗi buổi có giáo án riêng, huấn luyện viên chỉnh từng động tác.</p></li>
        <li><h3 class="d3">Giá hợp với chất lượng</h3><p>Kèm riêng 1:1 từ 420k mỗi buổi, kèm đôi từ 220k.</p></li>
        <li><h3 class="d3">Thấy cơ thể thay đổi</h3><p>Nhiều người tập lâu vì thấy người khoẻ lên thật, đúng cái họ muốn lúc mới vào.</p></li>
      </ol>
    </div>
  </section>

  <section class="sec duo">
    <div class="wrap duo-in">
      <div class="duo-a" data-parallax><Pic name="yoga-vuon-tay" alt="Học viên tập ở Nuseva Phan Đăng Lưu" sizes="(min-width: 900px) 38vw, 100vw" /></div>
      <div class="duo-txt">
        <Logo kind="cat" class="duo-cat" />
        <h2 class="d2" data-split>Sắp tới ở Nuseva</h2>
        <p data-reveal>Khi studio Phan Đăng Lưu ổn định, tụi mình sẽ mở thêm hai mảng: Rehab (phục hồi) và Bakehouse. Có tin gì Nu sẽ báo trên Facebook và Instagram trước tiên.</p>
        <a class="link" href={u('studio')} data-reveal>Xem hai studio</a>
      </div>
      <div class="duo-b" data-parallax><Pic name="buoc-vao-lop" alt="Học viên bước vào lớp" sizes="(min-width: 900px) 30vw, 100vw" /></div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .two{display:grid;grid-template-columns:4fr 8fr;gap:48px}
  .k{font:400 22px/1.3 var(--display)}
  .lead{max-width:30ch}
  .more{margin-top:40px}
  .why{background:var(--olive);color:var(--paper)}
  .sub{max-width:56ch;margin-top:24px}
  .why-list{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:56px}
  .why-list li{border-top:1px solid rgba(246,235,214,.45);padding-top:22px}
  .why-list p{margin-top:10px;font-size:15px}
  .duo-in{display:grid;grid-template-columns:5fr 6fr 4fr;gap:clamp(24px,4vw,56px);align-items:center}
  .duo-a{aspect-ratio:9/14;border-radius:var(--r);overflow:hidden}
  .duo-b{aspect-ratio:4/5;border-radius:var(--r);overflow:hidden;align-self:end}
  .duo-txt p{margin:20px 0 24px}
  :global(.duo-cat){width:150px;height:auto;color:var(--caramel);margin-bottom:24px}
  @media (max-width:899px){.two{grid-template-columns:1fr;gap:16px}.why-list{grid-template-columns:1fr 1fr}.duo-in{grid-template-columns:1fr}.duo-a{aspect-ratio:4/5}}
  @media (max-width:520px){.why-list{grid-template-columns:1fr}}
</style>
