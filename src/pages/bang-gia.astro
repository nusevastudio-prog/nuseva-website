---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pic from '../components/Pic.astro';
import CtaBand from '../components/CtaBand.astro';
import { prices, policies, site, rental } from '../data/site.js';
---
<Base title="Bảng giá" description="Giá tập Pilates ở Nuseva: kèm riêng 1:1 từ 420k/buổi, kèm đôi 1:2 từ 220k/buổi, lớp nhóm từ 130k/buổi. Buổi lẻ đầu tiên giảm 50%. Có cho huấn luyện viên thuê phòng tập từ 100k/giờ.">
  <PageHero title="Bảng giá" intro="Giá dưới đây là giá thấp nhất cho 1 buổi 60 phút của từng hình thức. Buổi lẻ đầu tiên giảm 50%." />

  <section class="wrap">
    <div class="cards" data-stagger>
      {prices.map((p, i) => (
        <article class={'card' + (i === 0 ? ' card-main' : '')}>
          <h2 class="d3">{p.label}</h2>
          <p class="from">từ</p>
          <b>{p.from}</b>
          <p class="unit">{p.unit}</p>
          <p class="note">{p.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="sec">
    <div class="wrap two">
      <div>
        <h2 class="d2" data-split>Gói tập và chính sách</h2>
        <p class="sub" data-reveal>Giá theo gói (bao nhiêu buổi, dùng trong bao lâu) thì Nu gửi qua Zalo, tiện tư vấn luôn gói nào hợp lịch của bạn.</p>
        <a class="btn btn-wine" href={site.zalo} target="_blank" rel="noopener" data-reveal>Nhận bảng giá qua Zalo</a>
      </div>
      <dl class="pol">
        {policies.map((p) => <div data-reveal><dt class="d4">{p.q}</dt><dd>{p.a}</dd></div>)}
        <div data-reveal><dt class="d4">Thanh toán</dt><dd>Trả bằng cách nào thì nhắn Nu hỏi nha.</dd></div>
      </dl>
    </div>
  </section>

  <section class="rent" id="thue-phong">
    <div class="wrap">
      <div class="rent-head">
        <p class="rent-k" data-reveal>Cho thuê studio</p>
        <h2 class="d2" data-split>Thuê phòng tập ở Nuseva</h2>
        <p class="sub" data-reveal>{rental.forWho}</p>
      </div>
      <div class="rent-grid" data-stagger>
        {rental.groups.map((g) => (
          <article class="rent-card">
            <h3 class="d4">{g.title}</h3>
            {g.note && <p class="rent-note">{g.note}</p>}
            <dl>{g.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          </article>
        ))}
      </div>
      <div class="rent-foot">
        <ul data-reveal>{rental.notes.map((n) => <li>{n}</li>)}</ul>
        <div class="rent-act" data-reveal>
          <p>Giờ nào còn trống thì nhắn Nu hỏi trước nha.</p>
          <a class="btn btn-cream" href={site.zalo} target="_blank" rel="noopener">Nhắn Zalo đặt phòng</a>
        </div>
      </div>
    </div>
  </section>

  <div class="sp"></div>
  <div class="wrap"><div class="band" data-parallax><Pic name="lo-xo-mau" alt="Lò xo màu của máy Reformer" sizes="100vw" /></div></div>
  <div class="sp"></div>
  <CtaBand />
</Base>
<style>
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .card{background:var(--paper);border-radius:var(--r);padding:clamp(28px,3.5vw,44px);display:flex;flex-direction:column;min-height:380px}
  .card-main{background:var(--wine);color:var(--paper)}
  .from{margin-top:auto;font-size:14px;opacity:.8}
  .card b{font:400 clamp(64px,7vw,104px)/1 var(--display)}
  .card:not(.card-main) b{color:var(--wine)}
  .unit{font-size:14px;margin-top:6px}
  .note{font-size:14px;margin-top:18px;padding-top:18px;border-top:1px solid currentColor;opacity:.85}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,96px)}
  .sub{margin:24px 0 28px;max-width:44ch}
  .pol{border-top:1px solid var(--line)}
  .pol div{padding:24px 0;border-bottom:1px solid var(--line)}
  .pol dd{margin-top:6px;color:var(--caramel)}
  .band{height:clamp(280px,46vh,520px);border-radius:var(--r);overflow:hidden}
  .sp{height:clamp(80px,10vw,140px)}
  .rent{background:#6B6446;color:var(--paper);padding:clamp(72px,9vw,128px) 0;scroll-margin-top:72px}
  .rent-k{font:400 18px/1.3 var(--display);color:var(--batter);margin-bottom:14px}
  .rent .sub{color:var(--paper);opacity:.9;max-width:56ch}
  .rent-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:8px}
  .rent-card{background:rgba(251,245,236,.1);border:1px solid rgba(251,245,236,.25);border-radius:var(--r);padding:clamp(24px,3vw,40px)}
  .rent-card h3{color:var(--paper)}
  .rent-note{font-size:13px;color:var(--batter);margin-top:6px}
  .rent-card dl{margin-top:20px}
  .rent-card dl div{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:16px 0;border-top:1px solid rgba(251,245,236,.25)}
  .rent-card dt{font-size:15px}
  .rent-card dd{font:400 clamp(24px,2.4vw,32px)/1 var(--display)}
  .rent-foot{display:grid;grid-template-columns:1.3fr 1fr;gap:32px;margin-top:40px;align-items:end}
  .rent-foot ul{list-style:none;font-size:15px;line-height:1.7}
  .rent-foot li{padding-left:18px;position:relative}
  .rent-foot li::before{content:'';position:absolute;left:0;top:.7em;width:6px;height:6px;border-radius:50%;background:var(--batter)}
  .rent-act p{margin-bottom:16px;opacity:.9}
  @media (max-width:899px){.cards,.two,.rent-grid,.rent-foot{grid-template-columns:1fr}.card{min-height:300px}}
</style>
