---
import Pic from './Pic.astro';
const { kicker, title, intro, image, alt = '', pos } = Astro.props;
---
<section class="ph">
  <div class="wrap">
    {kicker && <p class="ph-k" data-reveal>{kicker}</p>}
    <h1 class="d1" data-split>{title}</h1>
    {intro && <p class="ph-intro" data-reveal data-delay=".15">{intro}</p>}
    <slot />
  </div>
  {image && <div class="ph-pic" data-expand><Pic name={image} alt={alt} loading="eager" fetchpriority="high" pos={pos} /></div>}
</section>
<style>
  .ph{padding:clamp(56px,8vw,120px) 0 clamp(48px,6vw,80px)}
  .ph-k{font:400 18px/1.3 var(--display);color:var(--caramel);margin-bottom:18px}
  .ph h1{max-width:16ch}
  .ph-intro{max-width:52ch;margin-top:28px;font-size:17px}
  .ph-pic{height:clamp(360px,64vh,720px);margin-top:clamp(48px,6vw,80px);overflow:hidden;clip-path:inset(0 var(--gut) round 22px)}
  :global(.js) .ph-pic{clip-path:inset(0% 7% 0% 7% round 22px)}
  .ph-pic :global(img){width:100%;height:100%;object-fit:cover}
  @media (max-width:760px){:global(.js) .ph-pic{clip-path:inset(0 var(--gut) round 16px)}.ph-pic{height:52vh}}
</style>
