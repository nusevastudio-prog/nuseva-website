---
import Pic from './Pic.astro';
const { kicker, title, intro, image, alt = '', pos, fit } = Astro.props;
---
<section class="ph">
  <div class="wrap">
    {kicker && <p class="ph-k" data-reveal>{kicker}</p>}
    <h1 class="d1" data-split>{title}</h1>
    {intro && <p class="ph-intro" data-reveal data-delay=".15">{intro}</p>}
    <slot />
  </div>
  {image && (
    <div class:list={['ph-pic', fit === 'portrait' && 'is-portrait']} data-expand>
      {fit === 'portrait' && <div class="ph-bg" aria-hidden="true"><Pic name={image} alt="" loading="eager" sizes="40vw" widths={[480, 800]} /></div>}
      <Pic name={image} alt={alt} loading="eager" fetchpriority="high" pos={pos} class="ph-main" />
    </div>
  )}
</section>
<style>
  .ph{padding:clamp(56px,8vw,120px) 0 clamp(48px,6vw,80px)}
  .ph-k{font:400 18px/1.3 var(--display);color:var(--caramel);margin-bottom:18px}
  .ph h1{max-width:16ch}
  .ph-intro{max-width:52ch;margin-top:28px;font-size:17px}
  .ph-pic{height:clamp(360px,64vh,720px);margin-top:clamp(48px,6vw,80px);overflow:hidden;clip-path:inset(0 var(--gut) round 22px)}
  :global(.js) .ph-pic{clip-path:inset(0% 7% 0% 7% round 22px)}
  .ph-pic :global(img){width:100%;height:100%;object-fit:cover}
  .is-portrait{position:relative;background:var(--cocoa)}
  .ph-bg{position:absolute;inset:-40px;filter:blur(28px) saturate(.9) brightness(.85);transform:scale(1.1)}
  .is-portrait > :global(picture){position:relative;display:block}
  @media (min-width:761px){.is-portrait > :global(picture) :global(img){object-fit:contain;object-position:center!important}}
  @media (max-width:760px){:global(.js) .ph-pic{clip-path:inset(0 var(--gut) round 16px)}.ph-pic{height:52vh}}
</style>
