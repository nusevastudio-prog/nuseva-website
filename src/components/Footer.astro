---
import Logo from './Logo.astro';
import { site, studios, nav } from '../data/site.js';
import { u } from '../lib/url.js';
import icZalo from 'lucide-static/icons/message-circle.svg?raw';
import icFb from 'lucide-static/icons/facebook.svg?raw';
import icIg from 'lucide-static/icons/instagram.svg?raw';
const ic = (svg) => svg.replace(/<!--[\s\S]*?-->/g, '').replace('<svg', '<svg aria-hidden="true"');
const socials = [
  { href: site.zalo, label: 'Zalo', icon: ic(icZalo) },
  { href: site.facebook, label: 'Facebook', icon: ic(icFb) },
  { href: site.instagram, label: 'Instagram', icon: ic(icIg) },
];
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr-top">
      <div class="ftr-brand">
        <Logo class="ftr-logo" />
        <p>Pilates kèm riêng ở Quận 1 và Phú Nhuận. Từ {site.founded}.</p>
      </div>
      <div class="ftr-cols">
        {studios.map((s) => (
          <div>
            <h3>{s.name}</h3>
            <p>{s.address}<br />{s.district}, {s.city}</p>
            <a class="link" href={s.map} target="_blank" rel="noopener">Chỉ đường</a>
          </div>
        ))}
        <div>
          <h3>Liên hệ</h3>
          <p><a href={`tel:${site.phoneRaw}`}>{site.hotline}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a><br />{site.hours}, {site.hoursNote.toLowerCase()}</p>
          <ul class="ftr-social">{socials.map((x) => <li><a href={x.href} target="_blank" rel="noopener" aria-label={x.label} title={x.label}><span class="ico" set:html={x.icon} /></a></li>)}</ul>
        </div>
      </div>
    </div>
    <div class="ftr-bot">
      <ul>{nav.map((n) => <li><a href={u(n.href)}>{n.label}</a></li>)}<li><a href={u('album-anh')}>Album ảnh</a></li></ul>
      <p>© {new Date().getFullYear()} Nuseva Studio</p>
    </div>
  </div>
</footer>

<style>
  .ftr{background:var(--cocoa);color:var(--batter);padding:clamp(72px,9vw,120px) 0 32px}
  .ftr-top{display:grid;grid-template-columns:1fr 2fr;gap:56px;padding-bottom:64px;border-bottom:1px solid rgba(232,209,167,.2)}
  :global(.ftr-logo){width:180px;height:auto;margin-bottom:20px}
  .ftr-brand p{max-width:30ch;font-size:14px;opacity:.85}
  .ftr-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}
  .ftr h3{font:400 18px/1.3 var(--display);margin-bottom:12px;color:var(--paper)}
  .ftr p{font-size:14px;line-height:1.8}
  .ftr .link{display:inline-block;margin-top:10px;font-size:13px}
  .ftr-social{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;font-weight:600;font-size:13px}
  .ftr-social a{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border:1px solid rgba(232,209,167,.35);border-radius:999px;transition:background .3s,color .3s,border-color .3s}
  .ftr-social a:hover{background:var(--batter);color:var(--cocoa);border-color:var(--batter)}
  .ico{display:inline-flex;width:20px;height:20px}
  .ico :global(svg){width:20px;height:20px;stroke-width:1.6}
  .ftr-bot{display:flex;justify-content:space-between;gap:24px;padding-top:28px;font-size:13px;opacity:.8}
  .ftr-bot ul{display:flex;flex-wrap:wrap;gap:20px;list-style:none}
  @media (max-width:900px){.ftr-top{grid-template-columns:1fr}.ftr-cols{grid-template-columns:1fr 1fr}}
  @media (max-width:560px){.ftr-cols{grid-template-columns:1fr}.ftr-bot{flex-direction:column}.ftr{padding-bottom:110px}}
</style>
